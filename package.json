{
  "name": "orderdesk",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "description": "Backoffice de pedidos ficticio con code smells sembrados para el curso de Clean Architecture",
  "scripts": {
    "dev": "concurrently -n bff,web \"node server/index.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "demo:tema1": "vitest run examples/tema1",
    "map": "node scripts/map-imports.mjs",
    "hotspots": "node scripts/hotspots.mjs",
    "cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src",
    "smells": "eslint src --no-error-on-unmatched-pattern",
    "deps": "knip --dependencies --no-exit-code",
    "demo:tema3": "vitest run examples/tema3",
    "demo:tema4": "vitest run examples/tema4 src/orders",
    "lint:arch": "eslint --config eslint.architecture.js src/orders",
    "test:arch": "vitest run src/orders/architecture",
    "demo:tema5": "vitest run examples/tema5",
    "demo:tema6": "vitest run examples/tema6",
    "boundaries": "node scripts/boundaries.mjs",
    "rules": "node scripts/find-rules.mjs",
    "lint:boundaries": "eslint --config eslint.boundaries.js src",
    "demo:tema7": "vitest run examples/tema7",
    "demo:tema8": "vitest run examples/tema8",
    "test:contract": "vitest run src/orders/infrastructure/order-gateway.contract.test.ts",
    "demo:tema9": "vitest run examples/tema9",
    "demo:tema10": "vitest run examples/tema10",
    "state": "node scripts/state-map.mjs",
    "unused": "knip --files --no-exit-code",
    "demo:tema11": "vitest run examples/tema11",
    "demo:tema12": "vitest run examples/tema12",
    "demo:tema13": "vitest run examples/tema13",
    "test:bff": "vitest run server/bff.test.mjs",
    "test:policy": "vitest run src/orders/policy.contract.test.ts",
    "audit:secrets": "node scripts/secrets.mjs",
    "test:security": "vitest run src/security.test.ts src/session",
    "demo:tema14": "vitest run examples/tema14",
    "demo:tema15": "vitest run examples/tema15",
    "demo:tema16": "vitest run examples/tema16",
    "test:observability": "vitest run src/observability src/orders/observability.test.ts server/telemetry.test.mjs",
    "test:characterization": "vitest run src/pages/order-detail.characterization src/pages/dashboard.characterization",
    "mutate": "node scripts/mutate.mjs",
    "perf:budget": "node scripts/budget.mjs",
    "test:map": "node scripts/test-map.mjs",
    "demo:tema17": "vitest run examples/tema17",
    "demo:tema18": "vitest run examples/tema18",
    "demo:tema19": "vitest run examples/tema19",
    "test:integration": "vitest run src/orders/infrastructure/http-order-gateway.integration.test.ts",
    "test:components": "vitest run src/orders/ui/components",
    "test:frontera": "vitest run src/orders/infrastructure src/orders/testing",
    "test:weak": "node scripts/weak-asserts.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.7.9",
    "classnames": "^2.5.1",
    "express": "^4.21.2",
    "moment": "^2.30.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "knip": "^5.41.1",
    "madge": "^8.0.0",
    "msw": "^2.15.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
