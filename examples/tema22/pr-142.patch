--- /dev/null
+++ b/src/orders/ui/export-csv.ts
@@ -0,0 +1,9 @@
+// PRESENTACIÓN · Convierte filas en CSV. Función pura: sin React, sin red, sin fechas del sistema.
+export type CsvRow = { id: string; customer: string; status: string };
+
+const escape = (value: string): string => (/[",\n;]/.test(value) ? `"${value.replaceAll('"', '""')}"` : value);
+
+export function toCsv(rows: CsvRow[]): string {
+  const header = 'Pedido;Cliente;Estado';
+  return [header, ...rows.map((row) => [row.id, row.customer, row.status].map(escape).join(';'))].join('\n');
+}
