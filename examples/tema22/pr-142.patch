@@ -0,0 +1,25 @@
+import { useState } from 'react';
+import type { OrderDto } from '../infrastructure/order-dto';
+import { toCsv } from './export-csv';
+
+const API_KEY = import.meta.env.VITE_EXPORT_API_KEY;
+
+export function ExportButton({ role }: { role: string }) {
+  const [busy, setBusy] = useState(false);
+  if (role !== 'admin' && role !== 'manager') return null;
+
+  const exportCsv = async () => {
+    setBusy(true);
+    const res = await fetch(`/api/orders?key=${API_KEY}`, { credentials: 'include' });
+    const data = (await res.json()) as OrderDto[];
+    console.log('exportando', data.map((d) => d.cust_nm));
+    const csv = toCsv(data.map((d) => ({ id: d.ord_id, customer: d.cust_nm, status: d.ord_st })));
+    const link = document.createElement('a');
+    link.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
+    link.download = 'pedidos.csv';
+    link.click();
+    setBusy(false);
+  };
+
+  return <button onClick={exportCsv} disabled={busy}>Exportar CSV</button>;
+}
